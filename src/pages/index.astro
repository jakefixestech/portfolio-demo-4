---
// Moonstone & Sage - A Maximalist Bohemian Gift Shop Homepage
// Single-file Astro component with all the mystical vibes
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Moonstone & Sage | Mystical Gifts & Bohemian Treasures</title>
    <meta name="description" content="Step into Moonstone & Sage — your local haven for crystals, tarot, handmade jewelry, candles, incense, and mystical treasures on Main Street." />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://demo4.jakefixestech.com/" />
    <meta property="og:title" content="Moonstone & Sage | Mystical Gifts & Bohemian Treasures" />
    <meta property="og:description" content="Step into Moonstone & Sage — your local haven for crystals, tarot, handmade jewelry, candles, incense, and mystical treasures on Main Street." />
    <meta property="og:image" content="https://demo4.jakefixestech.com/og-image.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="A warm, candlelit mystical gift shop interior with crystals, candles, and bohemian treasures" />
    <meta property="og:site_name" content="Moonstone & Sage" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content="https://demo4.jakefixestech.com/" />
    <meta name="twitter:title" content="Moonstone & Sage | Mystical Gifts & Bohemian Treasures" />
    <meta name="twitter:description" content="Step into Moonstone & Sage — your local haven for crystals, tarot, handmade jewelry, candles, incense, and mystical treasures on Main Street." />
    <meta name="twitter:image" content="https://demo4.jakefixestech.com/og-image.jpg" />
    <meta name="twitter:image:alt" content="A warm, candlelit mystical gift shop interior with crystals, candles, and bohemian treasures" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <!-- Async load Google Fonts to eliminate render-blocking — preload as style, swap to stylesheet onload -->
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@400;700;900&family=Cinzel:wght@400;500;600;700&family=Crimson+Text:ital,wght@0,400;0,600;0,700;1,400&family=Satisfy&display=optional" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <noscript>
      <link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@400;700;900&family=Cinzel:wght@400;500;600;700&family=Crimson+Text:ital,wght@0,400;0,600;0,700;1,400&family=Satisfy&display=optional" rel="stylesheet">
    </noscript>
  </head>
  <body class="overflow-x-hidden">
    <main>
    
    <!-- ═══════════════════════════════════════════════════════════════════════════
         ROOM 1: THE THRESHOLD (HERO)
         Deep magenta/fuchsia atmosphere - The entrance to wonder
    ═══════════════════════════════════════════════════════════════════════════ -->
    <section class="relative min-h-screen overflow-hidden" style="background: radial-gradient(ellipse at top left, #6b1d4e 0%, #4a1438 40%, #2d0f3a 100%);">
      
      <!-- Decorative floating elements -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none">
        <!-- Stars and sparkles -->
        <div class="absolute top-20 left-[10%] w-2 h-2 bg-[#f4c542] rounded-full animate-pulse opacity-80"></div>
        <div class="absolute top-32 left-[25%] w-1 h-1 bg-[#f4c542] rounded-full animate-pulse opacity-60" style="animation-delay: 0.5s;"></div>
        <div class="absolute top-16 left-[40%] w-3 h-3 bg-[#f4c542] rounded-full animate-pulse opacity-70" style="animation-delay: 1s;"></div>
        <div class="absolute top-40 left-[55%] w-1.5 h-1.5 bg-[#f4c542] rounded-full animate-pulse opacity-90" style="animation-delay: 0.3s;"></div>
        <div class="absolute top-24 left-[70%] w-2 h-2 bg-[#f4c542] rounded-full animate-pulse opacity-75" style="animation-delay: 0.7s;"></div>
        <div class="absolute top-48 left-[85%] w-1 h-1 bg-[#f4c542] rounded-full animate-pulse opacity-65" style="animation-delay: 1.2s;"></div>
        <div class="absolute top-60 left-[15%] w-1.5 h-1.5 bg-[#f4c542] rounded-full animate-pulse opacity-80" style="animation-delay: 0.9s;"></div>
        <div class="absolute top-72 left-[90%] w-2 h-2 bg-[#f4c542] rounded-full animate-pulse opacity-70" style="animation-delay: 0.4s;"></div>
        
        <!-- Hanging decorations silhouettes -->
        <svg class="absolute top-0 left-[5%] w-16 h-32 text-[#2d0f3a]/50" viewBox="0 0 64 128" fill="currentColor">
          <path d="M32 0v40M32 40c-8 0-15 7-15 15s7 15 15 15 15-7 15-15-7-15-15-15M32 70v20M28 90l4 10 4-10" stroke="currentColor" stroke-width="2" fill="none"/>
          <circle cx="32" cy="55" r="12" opacity="0.5"/>
        </svg>
        <svg class="absolute top-0 right-[8%] w-12 h-28 text-[#2d0f3a]/40" viewBox="0 0 48 112" fill="currentColor">
          <path d="M24 0v30" stroke="currentColor" stroke-width="1" fill="none"/>
          <polygon points="24,30 12,60 24,55 36,60" opacity="0.6"/>
          <path d="M24 55v25M20 80l4 8 4-8" stroke="currentColor" stroke-width="1" fill="none"/>
        </svg>
        
        <!-- Moon phases decoration -->
        <div class="absolute top-8 right-[20%] flex gap-3 opacity-60">
          <div class="w-4 h-4 rounded-full bg-[#f4c542]/30"></div>
          <div class="w-5 h-5 rounded-full bg-[#f4c542]/50"></div>
          <div class="w-6 h-6 rounded-full bg-[#f4c542]/80"></div>
          <div class="w-5 h-5 rounded-full bg-[#f4c542]/50"></div>
          <div class="w-4 h-4 rounded-full bg-[#f4c542]/30"></div>
        </div>
        
        <!-- Mandala corner decorations -->
        <svg class="absolute -bottom-20 -left-20 w-64 h-64 text-[#f4c542]/10 rotate-45" viewBox="0 0 200 200">
          <circle cx="100" cy="100" r="90" fill="none" stroke="currentColor" stroke-width="1"/>
          <circle cx="100" cy="100" r="70" fill="none" stroke="currentColor" stroke-width="1"/>
          <circle cx="100" cy="100" r="50" fill="none" stroke="currentColor" stroke-width="1"/>
          <circle cx="100" cy="100" r="30" fill="none" stroke="currentColor" stroke-width="2"/>
          <path d="M100 10 L100 190 M10 100 L190 100 M30 30 L170 170 M170 30 L30 170" stroke="currentColor" stroke-width="0.5"/>
        </svg>
        <svg class="absolute -top-20 -right-20 w-72 h-72 text-[#f4c542]/10 -rotate-12" viewBox="0 0 200 200">
          <circle cx="100" cy="100" r="95" fill="none" stroke="currentColor" stroke-width="1"/>
          <circle cx="100" cy="100" r="75" fill="none" stroke="currentColor" stroke-width="1"/>
          <circle cx="100" cy="100" r="55" fill="none" stroke="currentColor" stroke-width="1"/>
          <circle cx="100" cy="100" r="35" fill="none" stroke="currentColor" stroke-width="2"/>
          {[...Array(12)].map((_, i) => `<line x1="100" y1="5" x2="100" y2="25" transform="rotate(${i * 30} 100 100)" stroke="currentColor" stroke-width="1"/>`).join('')}
        </svg>
      </div>
      
      <!-- Main hero content -->
      <div class="relative z-10 container mx-auto px-6 py-12 min-h-screen flex flex-col justify-center items-center text-center">
        
        <!-- Ornate top border -->
        <div class="absolute top-0 left-0 right-0 h-8 overflow-hidden">
          <svg class="w-full h-8" viewBox="0 0 1200 32" preserveAspectRatio="none">
            <path d="M0,32 Q150,0 300,16 T600,16 T900,16 T1200,32" fill="none" stroke="#f4c542" stroke-width="2" opacity="0.5"/>
            <path d="M0,28 Q150,4 300,20 T600,20 T900,20 T1200,28" fill="none" stroke="#f4c542" stroke-width="1" opacity="0.3"/>
          </svg>
        </div>
        
        <!-- Logo/Title Area -->
        <div class="mb-8 relative">
          <!-- Decorative crescent moons -->
          <span class="absolute -left-16 top-1/2 -translate-y-1/2 text-6xl text-[#f4c542]/70">☽</span>
          <span class="absolute -right-16 top-1/2 -translate-y-1/2 text-6xl text-[#f4c542]/70">☾</span>
          
          <h1 class="font-display text-5xl md:text-7xl lg:text-8xl text-[#f4c542] tracking-wider drop-shadow-lg" style="text-shadow: 0 0 40px rgba(244, 197, 66, 0.5);">
            Moonstone
            <span class="block text-3xl md:text-4xl lg:text-5xl text-[#fff5e6]/90 font-accent my-4">&</span>
            Sage
          </h1>
        </div>
        
        <!-- Tagline with decorative elements -->
        <div class="relative mb-12">
          <div class="flex items-center justify-center gap-4 mb-4">
            <span class="text-[#f4c542]">✦</span>
            <span class="w-24 h-px bg-gradient-to-r from-transparent via-[#f4c542] to-transparent"></span>
            <span class="text-[#f4c542]">☆</span>
            <span class="w-24 h-px bg-gradient-to-r from-transparent via-[#f4c542] to-transparent"></span>
            <span class="text-[#f4c542]">✦</span>
          </div>
          <p class="font-heading text-xl md:text-2xl text-[#fff5e6]/90 tracking-widest uppercase">
            Mystical Gifts & Bohemian Treasures
          </p>
          <p class="font-body text-lg text-[#f5a3c7] mt-3 italic">
            Since 1987 on Main Street
          </p>
        </div>
        
        <!-- Atmospheric description -->
        <p class="font-body text-lg md:text-xl text-[#fff5e6]/80 max-w-3xl leading-relaxed mb-12">
          Step through our door and let the incense embrace you. Crystals catch the light from every corner, 
          tapestries whisper ancient stories, and somewhere, wind chimes sing. 
          <span class="text-[#f4c542] font-semibold">This is your place.</span>
        </p>
        
        <!-- CTA Buttons with ornate styling -->
        <div class="flex flex-col sm:flex-row gap-6 mb-16">
          <a href="#shop-rooms" class="group relative px-10 py-4 bg-[#f4c542] text-[#2d0f3a] font-heading text-lg uppercase tracking-wider rounded-none overflow-hidden transition-all hover:scale-105 hover:shadow-[0_0_30px_rgba(244,197,66,0.5)]">
            <span class="relative z-10">Enter the Shop</span>
            <div class="absolute inset-0 bg-[#fff5e6] transform scale-x-0 group-hover:scale-x-100 transition-transform origin-left"></div>
          </a>
          <a href="#hours" class="group px-10 py-4 border-2 border-[#f4c542]/60 text-[#f4c542] font-heading text-lg uppercase tracking-wider hover:bg-[#f4c542]/10 transition-all hover:border-[#f4c542]">
            Visit Us ✧ 123 Main St
          </a>
        </div>
        
        <!-- Scroll indicator -->
        <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 animate-bounce">
          <span class="font-body text-sm text-[#fff5e6]/60">Explore Our Rooms</span>
          <svg class="w-6 h-6 text-[#f4c542]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
          </svg>
        </div>
      </div>
      
      <!-- Bottom wave transition -->
      <div class="absolute bottom-0 left-0 right-0">
        <svg class="w-full h-24" viewBox="0 0 1440 96" preserveAspectRatio="none">
          <path d="M0,64 C360,96 720,32 1080,64 C1260,80 1380,48 1440,64 L1440,96 L0,96 Z" fill="#0d4f4f"/>
        </svg>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════════════════
         ROOM 2: THE CRYSTAL CAVE
         Deep teal/turquoise with glowing accents
    ═══════════════════════════════════════════════════════════════════════════ -->
    <section id="shop-rooms" class="relative py-24 overflow-hidden" style="background: linear-gradient(180deg, #0d4f4f 0%, #1a7a7a 50%, #0d4f4f 100%);">
      
      <!-- Crystal/geometric decorations -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none">
        <!-- Glowing orbs representing crystals -->
        <div class="absolute top-20 left-[5%] w-20 h-20 rounded-full bg-[#7fdbdb]/20 blur-xl animate-pulse"></div>
        <div class="absolute top-40 right-[10%] w-32 h-32 rounded-full bg-[#9b59b6]/20 blur-2xl animate-pulse" style="animation-delay: 1s;"></div>
        <div class="absolute bottom-32 left-[15%] w-24 h-24 rounded-full bg-[#f5a3c7]/15 blur-xl animate-pulse" style="animation-delay: 0.5s;"></div>
        <div class="absolute top-60 left-[60%] w-16 h-16 rounded-full bg-[#7fdbdb]/25 blur-lg animate-pulse" style="animation-delay: 1.5s;"></div>
        
        <!-- Crystal shapes -->
        <svg class="absolute top-10 left-[20%] w-12 h-20 text-[#7fdbdb]/30" viewBox="0 0 48 80">
          <polygon points="24,0 48,60 24,80 0,60" fill="currentColor"/>
        </svg>
        <svg class="absolute top-32 right-[25%] w-8 h-14 text-[#9b59b6]/25 rotate-12" viewBox="0 0 32 56">
          <polygon points="16,0 32,42 16,56 0,42" fill="currentColor"/>
        </svg>
        <svg class="absolute bottom-20 right-[15%] w-10 h-16 text-[#f5a3c7]/20 -rotate-6" viewBox="0 0 40 64">
          <polygon points="20,0 40,48 20,64 0,48" fill="currentColor"/>
        </svg>
        
        <!-- Sparkle pattern -->
        <div class="absolute inset-0" style="background-image: radial-gradient(circle, #7fdbdb 1px, transparent 1px); background-size: 60px 60px; opacity: 0.1;"></div>
      </div>
      
      <div class="relative z-10 container mx-auto px-6">
        <!-- Section header with ornate styling -->
        <div class="text-center mb-16">
          <div class="flex items-center justify-center gap-4 mb-6">
            <svg class="w-8 h-8 text-[#7fdbdb]" viewBox="0 0 32 32" fill="currentColor">
              <polygon points="16,0 20,12 32,12 22,20 26,32 16,24 6,32 10,20 0,12 12,12"/>
            </svg>
            <h2 class="font-display text-4xl md:text-5xl text-[#7fdbdb] tracking-wide" style="text-shadow: 0 0 30px rgba(127, 219, 219, 0.5);">
              The Crystal Cave
            </h2>
            <svg class="w-8 h-8 text-[#7fdbdb]" viewBox="0 0 32 32" fill="currentColor">
              <polygon points="16,0 20,12 32,12 22,20 26,32 16,24 6,32 10,20 0,12 12,12"/>
            </svg>
          </div>
          <p class="font-body text-xl text-[#fff5e6]/80 max-w-2xl mx-auto">
            Where light dances through amethyst, rose quartz hums with love, and every crystal chooses its keeper
          </p>
        </div>
        
        <!-- Crystal categories in ornate cards -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-16">
          
          <!-- Card 1: Raw Crystals -->
          <div class="group relative p-8 bg-gradient-to-br from-[#0d4f4f]/80 to-[#1a7a7a]/60 border-2 border-[#7fdbdb]/30 rounded-lg overflow-hidden hover:border-[#7fdbdb]/60 transition-all hover:scale-[1.02] hover:shadow-[0_0_40px_rgba(127,219,219,0.3)]">
            <div class="absolute top-0 right-0 w-32 h-32 bg-[#9b59b6]/10 rounded-full blur-2xl"></div>
            <div class="relative">
              <div class="text-5xl mb-4">💎</div>
              <h3 class="font-heading text-2xl text-[#7fdbdb] mb-3">Raw Crystals & Clusters</h3>
              <p class="font-body text-[#fff5e6]/70 leading-relaxed">
                Amethyst cathedrals, citrine points, smoky quartz clusters, and raw specimens from every corner of Earth. 
                Feel their energy before you even touch them.
              </p>
              <div class="mt-4 flex flex-wrap gap-2">
                <span class="px-3 py-1 bg-[#9b59b6]/30 text-[#f5a3c7] text-sm rounded-full">Amethyst</span>
                <span class="px-3 py-1 bg-[#9b59b6]/30 text-[#f5a3c7] text-sm rounded-full">Citrine</span>
                <span class="px-3 py-1 bg-[#9b59b6]/30 text-[#f5a3c7] text-sm rounded-full">Quartz</span>
              </div>
            </div>
          </div>
          
          <!-- Card 2: Tumbled Stones -->
          <div class="group relative p-8 bg-gradient-to-br from-[#0d4f4f]/80 to-[#1a7a7a]/60 border-2 border-[#7fdbdb]/30 rounded-lg overflow-hidden hover:border-[#7fdbdb]/60 transition-all hover:scale-[1.02] hover:shadow-[0_0_40px_rgba(127,219,219,0.3)]">
            <div class="absolute top-0 right-0 w-32 h-32 bg-[#f5a3c7]/10 rounded-full blur-2xl"></div>
            <div class="relative">
              <div class="text-5xl mb-4">🔮</div>
              <h3 class="font-heading text-2xl text-[#7fdbdb] mb-3">Tumbled Stones & Spheres</h3>
              <p class="font-body text-[#fff5e6]/70 leading-relaxed">
                Bins overflowing with polished treasures — tiger&apos;s eye, lapis lazuli, obsidian, moonstone. 
                Spheres for scrying, palm stones for meditation, worry stones for your pocket.
              </p>
              <div class="mt-4 flex flex-wrap gap-2">
                <span class="px-3 py-1 bg-[#7fdbdb]/20 text-[#7fdbdb] text-sm rounded-full">Palm Stones</span>
                <span class="px-3 py-1 bg-[#7fdbdb]/20 text-[#7fdbdb] text-sm rounded-full">Spheres</span>
                <span class="px-3 py-1 bg-[#7fdbdb]/20 text-[#7fdbdb] text-sm rounded-full">Hearts</span>
              </div>
            </div>
          </div>
          
          <!-- Card 3: Crystal Jewelry -->
          <div class="group relative p-8 bg-gradient-to-br from-[#0d4f4f]/80 to-[#1a7a7a]/60 border-2 border-[#7fdbdb]/30 rounded-lg overflow-hidden hover:border-[#7fdbdb]/60 transition-all hover:scale-[1.02] hover:shadow-[0_0_40px_rgba(127,219,219,0.3)]">
            <div class="absolute top-0 right-0 w-32 h-32 bg-[#7fdbdb]/10 rounded-full blur-2xl"></div>
            <div class="relative">
              <div class="text-5xl mb-4">✨</div>
              <h3 class="font-heading text-2xl text-[#7fdbdb] mb-3">Crystal Jewelry</h3>
              <p class="font-body text-[#fff5e6]/70 leading-relaxed">
                Handwrapped pendants, crystal point necklaces, gemstone rings, and chakra bracelets. 
                Wear your intentions. Carry your protection.
              </p>
              <div class="mt-4 flex flex-wrap gap-2">
                <span class="px-3 py-1 bg-[#f5a3c7]/20 text-[#f5a3c7] text-sm rounded-full">Pendants</span>
                <span class="px-3 py-1 bg-[#f5a3c7]/20 text-[#f5a3c7] text-sm rounded-full">Rings</span>
                <span class="px-3 py-1 bg-[#f5a3c7]/20 text-[#f5a3c7] text-sm rounded-full">Bracelets</span>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Featured crystal banner -->
        <div class="relative p-8 md:p-12 bg-gradient-to-r from-[#9b59b6]/30 via-[#0d4f4f]/50 to-[#9b59b6]/30 border border-[#9b59b6]/40 rounded-lg overflow-hidden">
          <div class="absolute inset-0 opacity-20" style="background-image: url('data:image/svg+xml,%3Csvg width=&quot;60&quot; height=&quot;60&quot; viewBox=&quot;0 0 60 60&quot; xmlns=&quot;http://www.w3.org/2000/svg&quot;%3E%3Cpath d=&quot;M30 5 L35 25 L55 30 L35 35 L30 55 L25 35 L5 30 L25 25 Z&quot; fill=&quot;%239b59b6&quot; fill-opacity=&quot;0.3&quot;/%3E%3C/svg%3E');"></div>
          <div class="relative flex flex-col md:flex-row items-center gap-8">
            <div class="text-8xl animate-pulse">🌙</div>
            <div class="text-center md:text-left">
              <span class="font-accent text-2xl text-[#f5a3c7]">This Month&apos;s Stone</span>
              <h3 class="font-display text-3xl md:text-4xl text-[#fff5e6] mt-2">Labradorite</h3>
              <p class="font-body text-[#7fdbdb] mt-3 max-w-xl">
                The stone of transformation and magic. Watch the flash of blue, green, and gold dance across its surface — 
                each piece holds the aurora borealis within.
              </p>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Transition to next section -->
      <div class="absolute bottom-0 left-0 right-0">
        <svg class="w-full h-20" viewBox="0 0 1440 80" preserveAspectRatio="none">
          <path d="M0,0 C480,80 960,0 1440,80 L1440,80 L0,80 Z" fill="#8b4513"/>
        </svg>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════════════════
         ROOM 3: THE CANDLE CORNER
         Warm amber/orange glow like candlelight
    ═══════════════════════════════════════════════════════════════════════════ -->
    <section class="relative py-24 overflow-hidden" style="background: linear-gradient(135deg, #8b4513 0%, #cc5500 30%, #8b4513 70%, #5c2e0a 100%);">
      
      <!-- Candle glow effects -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none">
        <div class="absolute top-20 left-[10%] w-40 h-40 rounded-full bg-[#f5a623]/30 blur-3xl animate-pulse"></div>
        <div class="absolute top-40 right-[15%] w-48 h-48 rounded-full bg-[#f5a623]/25 blur-3xl animate-pulse" style="animation-delay: 0.7s;"></div>
        <div class="absolute bottom-20 left-[30%] w-36 h-36 rounded-full bg-[#fff5e6]/20 blur-2xl animate-pulse" style="animation-delay: 1.2s;"></div>
        <div class="absolute top-1/2 right-[5%] w-32 h-32 rounded-full bg-[#cc5500]/40 blur-2xl animate-pulse" style="animation-delay: 0.3s;"></div>
        
        <!-- Smoke wisps -->
        <svg class="absolute top-10 left-[25%] w-8 h-32 text-[#fff5e6]/10 animate-pulse" viewBox="0 0 32 128">
          <path d="M16 128 Q8 100 16 80 Q24 60 16 40 Q8 20 16 0" fill="none" stroke="currentColor" stroke-width="2"/>
        </svg>
        <svg class="absolute top-20 right-[30%] w-6 h-24 text-[#fff5e6]/10 animate-pulse" style="animation-delay: 0.5s;" viewBox="0 0 24 96">
          <path d="M12 96 Q4 75 12 56 Q20 37 12 18 Q4 0 12 0" fill="none" stroke="currentColor" stroke-width="1.5"/>
        </svg>
      </div>
      
      <div class="relative z-10 container mx-auto px-6">
        <!-- Section header -->
        <div class="text-center mb-16">
          <div class="flex items-center justify-center gap-4 mb-6">
            <span class="text-4xl">🕯️</span>
            <h2 class="font-display text-4xl md:text-5xl text-[#f5a623] tracking-wide" style="text-shadow: 0 0 30px rgba(245, 166, 35, 0.6);">
              The Candle Corner
            </h2>
            <span class="text-4xl">🕯️</span>
          </div>
          <p class="font-body text-xl text-[#fff5e6]/90 max-w-2xl mx-auto">
            Incense smoke curls toward the ceiling. The air is thick with sandalwood, dragon&apos;s blood, and nag champa. 
            Every breath is a blessing.
          </p>
        </div>
        
        <!-- Product showcase in layered cards -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
          
          <!-- Candles -->
          <div class="relative p-8 bg-[#5c2e0a]/60 border-2 border-[#f5a623]/40 rounded-lg backdrop-blur-sm">
